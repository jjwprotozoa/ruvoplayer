{
    "version": 2,
    "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
    "builds": [
        {
            "src": "src/vercel.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/vercel.ts"
        }
    ]
}
